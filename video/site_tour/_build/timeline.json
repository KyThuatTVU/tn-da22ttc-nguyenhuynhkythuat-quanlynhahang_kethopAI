 "cues": [
  {
   "scene": "s01",
   "text": "Một nhà hàng miền Tây, giờ đây có mặt trên một nền tảng số duy nhất.",
   "start": 0.22,
   "end": 3.896
  },
  {
   "scene": "s01",
   "text": "Từ điện thoại của khách, đến quầy phục vụ và phòng quản trị.",
   "start": 4.726,
   "end": 7.776
  },
  {
   "scene": "s01",
   "text": "Mời bạn cùng xem, từ giao diện đến từng chức năng.",
   "start": 8.606,
   "end": 11.482
  },
  {
   "scene": "s02",
   "text": "Website phục vụ ba nhóm người dùng: khách hàng, nhân viên và quản trị viên.",
   "start": 16.22,
   "end": 20.444
  },
  {
   "scene": "s02",
   "text": "Khách đặt món, đặt bàn, thanh toán và trò chuyện với trợ lý ảo.",
   "start": 21.274,
   "end": 25.037
  },
  {
   "scene": "s02",
   "text": "Nhân viên chấm công bằng khuôn mặt, xem ca làm và bán hàng tại quầy.",
   "start": 25.867,
   "end": 29.494
  },
  {
   "scene": "s02",
   "text": "Quản trị viên theo dõi toàn bộ hoạt động qua dashboard.",
   "start": 30.324,
   "end": 33.039
  },
  {
   "scene": "s02",
   "text": "Phía sau là Node.js, Flask, MySQL và các mô hình học máy.",
   "start": 33.869,
   "end": 38.173
  },
  {
   "scene": "s03",
   "text": "Trang chủ là điểm chạm đầu tiên của khách.",
   "start": 40.22,
   "end": 42.132
  },
  {
   "scene": "s03",
   "text": "Ảnh lớn giới thiệu không gian, bên dưới là top món bán chạy.",
   "start": 42.962,
   "end": 46.34
  },
  {
   "scene": "s03",
   "text": "Mỗi khách còn thấy một khối gợi ý dành riêng cho mình.",
   "start": 47.17,
   "end": 49.752
  },
  {
   "scene": "s03",
   "text": "Thanh điều hướng giữ mọi chức năng trong tầm tay.",
   "start": 50.582,
   "end": 52.814
  },
  {
   "scene": "s03",
   "text": "Từ đây, chỉ một cú nhấp để xem thực đơn hoặc đặt bàn.",
   "start": 53.644,
   "end": 56.625
  },
  {
   "scene": "s04",
   "text": "Trang thực đơn hiển thị hai mươi lăm món, chia theo danh mục.",
   "start": 62.22,
   "end": 65.201
  },
  {
   "scene": "s04",
   "text": "Khách lọc theo món chính, khai vị, đồ uống hoặc khoảng giá.",
   "start": 66.031,
   "end": 69.503
  },
  {
   "scene": "s04",
   "text": "Thanh tìm kiếm và sắp xếp giúp chọn món trong vài giây.",
   "start": 70.333,
   "end": 73.085
  },
  {
   "scene": "s04",
   "text": "Những món phù hợp khẩu vị được gắn nhãn ngay trên ảnh.",
   "start": 73.915,
   "end": 76.694
  },
  {
   "scene": "s04",
   "text": "Giá và trạng thái còn hàng cập nhật trực tiếp từ cơ sở dữ liệu.",
   "start": 77.524,
   "end": 80.868
  },
  {
   "scene": "s05",
   "text": "Bấm vào một món, hộp chi tiết mở ra với ảnh, mô tả và giá.",
   "start": 86.22,
   "end": 90.174
  },
  {
   "scene": "s05",
   "text": "Khách chọn số lượng rồi thêm vào giỏ.",
   "start": 91.004,
   "end": 92.929
  },
  {
   "scene": "s05",
   "text": "Giỏ hàng cập nhật ngay, kèm gợi ý những món dùng chung.",
   "start": 93.759,
   "end": 97.022
  },
  {
   "scene": "s05",
   "text": "Toàn bộ nội dung được giữ lại khi chuyển sang thanh toán.",
   "start": 97.852,
   "end": 100.527
  },
  {
   "scene": "s05",
   "text": "Nhờ vậy, khách không phải chọn lại từ đầu.",
   "start": 101.357,
   "end": 103.687
  },
  {
   "scene": "s06",
   "text": "Quy trình đặt món đi qua ba bước: thông tin, thanh toán và hoàn tất.",
   "start": 110.22,
   "end": 113.973
  },
  {
   "scene": "s06",
   "text": "Hệ thống hỗ trợ thanh toán khi nhận hàng và ví MoMo.",
   "start": 114.803,
   "end": 117.579
  },
  {
   "scene": "s06",
   "text": "Với MoMo, khách quét mã QR và nhận xác nhận tức thì.",
   "start": 118.409,
   "end": 121.784
  },
  {
   "scene": "s06",
   "text": "Đơn hàng lập tức xuất hiện trong màn hình quản trị.",
   "start": 122.614,
   "end": 124.985
  },
  {
   "scene": "s06",
   "text": "Trạng thái đơn được cập nhật theo từng công đoạn.",
   "start": 125.815,
   "end": 128.086
  },
  {
   "scene": "s07",
   "text": "Với đặt bàn, khách tự chọn ngày, giờ và số người.",
   "start": 136.22,
   "end": 139.38
  },
  {
   "scene": "s07",
   "text": "Hệ thống kiểm tra sức chứa trước khi xác nhận.",
   "start": 140.21,
   "end": 142.51
  },
  {
   "scene": "s07",
   "text": "Mã đặt bàn được gửi ngay trên màn hình.",
   "start": 143.34,
   "end": 145.236
  },
  {
   "scene": "s07",
   "text": "Lịch sử đặt bàn nằm trong tài khoản cá nhân.",
   "start": 146.066,
   "end": 148.371
  },
  {
   "scene": "s07",
   "text": "Nhà hàng cũng thấy danh sách này trong mục quản lý.",
   "start": 149.201,
   "end": 151.597
  },
  {
   "scene": "s08",
   "text": "Nếu chưa biết chọn món nào, khách có thể hỏi Trà My.",
   "start": 158.22,
   "end": 161.098
  },
  {
   "scene": "s08",
   "text": "Trà My là trợ lý ảo hoạt động hai bốn trên bảy.",
   "start": 161.928,
   "end": 164.586
  },
  {
   "scene": "s08",
   "text": "Câu hỏi được tìm trong kho tri thức bằng tìm kiếm ngữ nghĩa.",
   "start": 165.416,
   "end": 168.355
  },
  {
   "scene": "s08",
   "text": "Sau đó mô hình ngôn ngữ lớn soạn câu trả lời tự nhiên.",
   "start": 169.185,
   "end": 172.159
  },
  {
   "scene": "s08",
   "text": "Trà My cũng gợi ý món và hỗ trợ đặt bàn ngay trong đoạn chat.",
   "start": 172.989,
   "end": 176.14
  },
  {
   "scene": "s09",
   "text": "Điểm khác biệt của đồ án nằm ở gợi ý cá nhân hóa.",
   "start": 182.22,
   "end": 185.083
  },
  {
   "scene": "s09",
   "text": "Hệ thống học từ lịch sử đơn hàng, đánh giá và câu hỏi chatbot.",
   "start": 185.913,
   "end": 189.313
  },
  {
   "scene": "s09",
   "text": "Bốn tín hiệu được chuẩn hóa rồi kết hợp với trọng số.",
   "start": 190.143,
   "end": 192.912
  },
  {
   "scene": "s09",
   "text": "Lọc cộng tác, độ khớp nội dung, ngữ cảnh chat và chất lượng món.",
   "start": 193.742,
   "end": 197.612
  },
  {
   "scene": "s09",
   "text": "Kết quả là danh sách món phù hợp với từng khách.",
   "start": 198.442,
   "end": 200.653
  },
  {
   "scene": "s09",
   "text": "Khách mới chưa có dữ liệu sẽ nhận danh sách món thịnh hành.",
   "start": 201.483,
   "end": 204.247
  },
  {
   "scene": "s10",
   "text": "Nhân viên đăng nhập ở cổng riêng, với vai trò được phân quyền.",
   "start": 208.22,
   "end": 211.379
  },
  {
   "scene": "s10",
   "text": "Chấm công bằng khuôn mặt, không cần thẻ từ.",
   "start": 212.209,
   "end": 214.549
  },
  {
   "scene": "s10",
   "text": "Hệ thống nhận diện và ghi nhận giờ vào, giờ ra.",
   "start": 215.379,
   "end": 218.161
  },
  {
   "scene": "s10",
   "text": "Màn hình POS giúp gọi món và thanh toán tại bàn.",
   "start": 218.991,
   "end": 221.82
  },
  {
   "scene": "s10",
   "text": "Ca làm và lương tạm tính cũng xem được ngay.",
   "start": 222.65,
   "end": 224.966
  },
  {
   "scene": "s10",
   "text": "Mọi thao tác đều đồng bộ với quản trị.",
   "start": 225.796,
   "end": 227.823
  },
  {
   "scene": "s11",
   "text": "Phía quản trị là một dashboard tổng hợp.",
   "start": 232.22,
   "end": 234.322
  },
  {
   "scene": "s11",
   "text": "Doanh thu, đơn hàng theo trạng thái, top món bán chạy.",
   "start": 235.152,
   "end": 238.506
  },
  {
   "scene": "s11",
   "text": "Biểu đồ khách hàng mới và phương thức thanh toán.",
   "start": 239.336,
   "end": 241.745
  },
  {
   "scene": "s11",
   "text": "Mọi con số cập nhật theo thời gian thực.",
   "start": 242.575,
   "end": 244.534
  },
  {
   "scene": "s11",
   "text": "Từ đây, quản lý điều hướng đến thực đơn, kho, nhân sự và báo cáo.",
   "start": 245.364,
   "end": 249.688
  },
  {
   "scene": "s11",
   "text": "Phân quyền chi tiết quyết định mỗi người được xem gì.",
   "start": 250.518,
   "end": 252.938
  },
  {
   "scene": "s12",
   "text": "Hệ thống còn ghi lại khẩu vị và món khách quan tâm.",
   "start": 258.22,
   "end": 260.866
